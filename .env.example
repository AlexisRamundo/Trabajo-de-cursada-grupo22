# Variables de entorno - App de gestión de tareas (Grupo 22)

# Este archivo sirve como plantilla base. Al ejecutar el proyecto
# mediante run-app.sh, Makefile o la aplicación, se generará automáticamente el
# archivo .env con estos valores si no existe.

# Puerto en el que escucha el servidor HTTP
PORT=8080

# Parámetros individuales de conexión a PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=todolist_test

# Cadena de conexión completa a PostgreSQL
# (DATABASE_URL tiene precedencia si está definida)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todolist_test?sslmode=disable
